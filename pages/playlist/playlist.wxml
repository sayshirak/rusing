<view class="container">
  <view class="card">
    <text class="section-title">歌单切换</text>
    <scroll-view scroll-x class="playlist-tabs">
      <view class="tab-wrap">
        <block wx:for="{{playlists}}" wx:key="playlistId">
          <view
            class="tab-item {{playlistId === item.playlistId ? 'tab-item-active' : ''}}"
            data-id="{{item.playlistId}}"
            bindtap="onSwitchPlaylist"
          >
            {{item.name}}
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="card" wx:if="{{currentPlaylist}}">
    <text class="section-title">{{currentPlaylist.name}}</text>
    <text class="subtitle">{{currentPlaylist.description}}</text>
  </view>

  <view class="card">
    <text class="section-title">曲目列表</text>
    <view wx:if="{{loading}}" class="subtitle">加载中...</view>
    <block wx:for="{{tracks}}" wx:key="trackId">
      <view class="track-item" data-track-id="{{item.trackId}}" bindtap="onTapTrack">
        <view>
          <text class="track-title">{{item.title}}</text>
          <text class="subtitle">{{item.artist}}</text>
        </view>
        <text class="track-duration">{{item.displayDuration}}</text>
      </view>
    </block>
  </view>
</view>
