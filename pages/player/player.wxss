.hero {
  text-align: center;
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}

.cover-wrap {
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e8eef2;
}

.cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7d8ea4;
  font-size: 92rpx;
  font-weight: 700;
}

.track-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.track-artist {
  display: block;
  color: #5f6d81;
  margin-top: 8rpx;
}

.track-time {
  display: block;
  font-size: 24rpx;
  color: #8190a4;
}

.progress-wrap {
  margin-top: 20rpx;
}

.progress-slider {
  margin: 0;
}

.progress-time-row {
  margin-top: 6rpx;
  display: flex;
  justify-content: space-between;
}

.controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 44rpx;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn-side {
  width: 96rpx;
  height: 96rpx;
}

.icon-btn-main {
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background: #0f8b8d;
}

.icon-prev,
.icon-next {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.icon-bar {
  width: 8rpx;
  height: 44rpx;
  background: #3a4a5f;
  border-radius: 6rpx;
}

.icon-triangle-left {
  width: 0;
  height: 0;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  border-right: 34rpx solid #3a4a5f;
}

.icon-triangle-right {
  width: 0;
  height: 0;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  border-left: 34rpx solid #3a4a5f;
}

.icon-play {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 26rpx solid transparent;
  border-bottom: 26rpx solid transparent;
  border-left: 42rpx solid #ffffff;
}

.icon-pause {
  display: flex;
  gap: 14rpx;
}

.pause-bar {
  width: 10rpx;
  height: 52rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mode-text {
  color: #0f8b8d;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.list-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #edf1f4;
  padding: 14rpx 0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-index {
  width: 44rpx;
  color: #90a0b5;
}

.list-body {
  display: flex;
  flex-direction: column;
}

.list-title {
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

.active-item .list-title {
  color: #0f8b8d;
  font-weight: 700;
}
